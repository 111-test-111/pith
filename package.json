{
  "name": "pith",
  "version": "0.1.0",
  "description": "An independent Electron desktop client for the Pi coding agent",
  "type": "module",
  "main": "out/main/index.mjs",
  "author": "Pith contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/111-test-111/pith.git"
  },
  "bugs": {
    "url": "https://github.com/111-test-111/pith/issues"
  },
  "homepage": "https://github.com/111-test-111/pith#readme",
  "scripts": {
    "postinstall": "node scripts/prepare-pi-sdk.mjs && node scripts/prepare-terminal.mjs && node scripts/prepare-file-icons.mjs",
    "dev": "electron-vite dev",
    "predev": "node scripts/prepare-pi-sdk.mjs && node scripts/prepare-file-icons.mjs",
    "build": "electron-vite build",
    "prebuild": "node scripts/prepare-pi-sdk.mjs && node scripts/prepare-file-icons.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:core": "node scripts/test.mjs --group core",
    "test:ui": "node scripts/test.mjs --group ui",
    "test:native": "node scripts/test.mjs --group native",
    "test:performance": "node scripts/test.mjs --group performance",
    "test:live": "node scripts/test.mjs --group live",
    "test:list": "node scripts/test.mjs --list",
    "clean": "node scripts/clean.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:file-icons": "node scripts/prepare-file-icons.mjs",
    "icons:file-types": "node scripts/generate-file-icon-map.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "benchmark:long-session": "node scripts/benchmark-long-session.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@floating-ui/react": "^0.27.20",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@mermaid-js/layout-elk": "1.0.1",
    "@paper-design/shaders-react": "^0.0.80",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@typesafe-ai/sdk": "0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chardet": "2.2.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "5.11.2",
    "hyparquet": "1.31.2",
    "hyparquet-compressors": "1.1.2",
    "jsonc-parser": "3.3.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "12.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "^1.63.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "shiki": "^4.4.3",
    "smol-toml": "1.9.0",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "3.2.2",
    "temml": "^0.13.5",
    "tldts": "7.4.16",
    "typebox": "1.3.7",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.1.2-rc.1",
    "@deepseek-ai/node-addon-landlock-run": "0.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "3.1.5",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hyparquet-writer": "0.16.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "Pith"
}
