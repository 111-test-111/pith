{
  "name": "pith",
  "version": "0.1.0",
  "description": "Pith — desktop client for pi-agent",
  "type": "module",
  "main": "out/main/index.mjs",
  "author": "pi-app",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.mjs && node scripts/prepare-file-icons.mjs",
    "dev": "electron-vite dev",
    "predev": "node scripts/prepare-file-icons.mjs",
    "build": "electron-vite build",
    "prebuild": "node scripts/prepare-file-icons.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "clean": "rm -rf node_modules/.vite out",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:file-icons": "node scripts/prepare-file-icons.mjs",
    "icons:file-types": "node scripts/generate-file-icon-map.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "check:context-budget": "node scripts/check-context-budget.mjs",
    "check:session-replay": "node scripts/check-session-replay.mjs",
    "check:long-session-benchmark": "node scripts/check-long-session-benchmark.mjs",
    "benchmark:long-session": "node scripts/benchmark-long-session.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@floating-ui/react": "^0.27.20",
    "@lobehub/icons-static-svg": "^1.95.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@phosphor-icons/react": "^2.1.10",
    "@typesafe-ai/sdk": "0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "^1.63.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "temml": "^0.13.5",
    "typebox": "1.3.7"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.1.2-rc.1",
    "@deepseek-ai/node-addon-landlock-run": "0.1.1"
  },
  "devDependencies": {
    "@iconify-json/catppuccin": "^1.2.17",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "Pith"
}
